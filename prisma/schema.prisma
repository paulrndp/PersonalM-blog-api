datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  firstname String
  lastname  String
  desc      String?
  profile   Bytes?
  createdAt DateTime @default(now())
}

model Story {
  id            Int       @id @default(autoincrement())
  title         String
  desc          String
  tags          String?
  genre         String?
  cover         Bytes?
  views         Int?      @default(0)
  totalChapters Int?      @default(0)
  createdAt     DateTime  @default(now())
  chapters      Chapter[]
}

model Chapter {
  id        Int      @id @default(autoincrement())
  storyId   Int      @map("story_id")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  views     Int?     @default(0)
  createdAt DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String?
  content   String?
  category  String?  // 'Blog' | 'Random' | 'Both'
  status    String?  // 'draft' | 'published'
  views     Int?     @default(0)
  createdAt DateTime @default(now())
}

model Gallery {
  id        Int      @id @default(autoincrement())
  category  String?
  images    Bytes?
  createdAt DateTime @default(now())
}

model Visitor {
  id        Int     @id @default(autoincrement())
  postId    Int
  point     String? // 'Blog' | 'Random' | 'Both' | 'Story'
  visitorIp String?
}
